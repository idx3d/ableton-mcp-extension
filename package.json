{
  "name": "ableton-mcp-extension",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "ableton-mcp": "dist/bridge.cjs"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:fake": "tsx src/dev/fake-server.ts",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:tools": "tsx scripts/gen-tools-md.ts",
    "setup:sdk": "npm install --no-save file:references/extensions-sdk-1.0.0-beta.0/ableton-extensions-sdk-1.0.0-beta.0.tgz file:references/extensions-sdk-1.0.0-beta.0/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "typecheck:sdk": "tsc --noEmit -p tsconfig.sdk.json",
    "build": "tsx build.ts",
    "build:dev": "tsx build.ts --dev",
    "start": "npm run build:dev && extensions-cli run .",
    "package": "npm run build && node scripts/package-ablx.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
